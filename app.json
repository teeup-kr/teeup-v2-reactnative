{
  "expo": {
    "name": "티업링크",
    "shortName": "TeeUp",
    "slug": "teeup",
    "scheme": "teeup",
    "version": "1.0.2",
    "icon": "./public/icons/icon-1024.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/icons/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-1024-transparent.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": false,
      "package": "com.pixencrew.teeup",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-600-transparent-full.png"
    },
    "ios": {
      "bundleIdentifier": "com.pixencrew.teeup",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.791884628850-2qfg8ak77aatafamacav929ol9jvph9f"
        }
      ]
    ],
    "extra": {}
  }
}
