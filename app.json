{
  "expo": {
    "name": "티업링크",
    "shortName": "TeeUp",
    "slug": "teeup",
    "scheme": "teeup",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./public/icons/icon-1024.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/icons/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-1024-transparent.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": false,
      "package": "com.pixencrew.teeup"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-192-transparent.png"
    },
    "ios": {
      "bundleIdentifier": "com.pixencrew.teeup"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {}
  }
}
