{
  "expo": {
    "name": "티업링크",
    "shortName": "TeeUp",
    "slug": "teeup",
    "scheme": "teeup",
    "version": "1.0.1",
    "icon": "./public/icons/icon-1024.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/icons/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-1024-transparent.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": false,
      "package": "com.pixencrew.teeup",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-600-transparent-full.png"
    },
    "ios": {
      "bundleIdentifier": "com.pixencrew.teeup",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleName": "티업링크"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.teeup.kr"
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.791884628850-2qfg8ak77aatafamacav929ol9jvph9f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e3e81f6c-8e50-40e3-a2dd-f5364afa2205"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/e3e81f6c-8e50-40e3-a2dd-f5364afa2205"
    },
    "owner": "jungeuilab"
  }
}
