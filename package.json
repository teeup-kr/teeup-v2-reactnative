{
  "name": "teeup",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "EAS_BUILD_PLATFORM=android expo prebuild --platform android && cd android && EAS_BUILD_PLATFORM=android ./gradlew :app:assembleRelease && cd .. && adb install android/app/build/outputs/apk/release/app-release.apk",
    "android:clean": "EAS_BUILD_PLATFORM=android expo prebuild --platform android --clean && cd android && EAS_BUILD_PLATFORM=android ./gradlew :app:assembleRelease && cd .. && adb install android/app/build/outputs/apk/release/app-release.apk",
    "android:release:aab": "bash scripts/android-release-aab.sh",
    "android:dev": "EAS_BUILD_PLATFORM=android expo run:android",
    "web:dev": "EAS_BUILD_PLATFORM=web NODE_OPTIONS=--inspect-brk expo start -c --web --port 8081",
    "web:static": "EAS_BUILD_PLATFORM=web npx expo export -p web",
    "test": "npm run lint && jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-picker/picker": "2.11.1",
    "@tanstack/react-query": "^5.90.16",
    "expo": "~54.0.30",
    "expo-device": "~8.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-navigation-bar": "^5.0.10",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-native": "0.81.5",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "sanitize-html": "^2.14.0"
  },
  "private": true,
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^10.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.7",
    "react-test-renderer": "19.1.0"
  }
}
